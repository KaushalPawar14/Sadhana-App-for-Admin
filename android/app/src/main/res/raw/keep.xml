<?xml version="1.0" encoding="utf-8"?>
<!-- Release shrinking must keep the notification icon: it is looked up by NAME at run time
     (flutter_local_notifications / Firebase Messaging), which the resource shrinker cannot see. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_notification,@mipmap/ic_launcher,@color/notification_color" />
